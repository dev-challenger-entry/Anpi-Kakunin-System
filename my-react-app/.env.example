# =========================================================================
# 【重要】このファイル（.env.example）は、環境変数の「型紙（テンプレート）」です！
# 使い方：
#   1. このファイルをコピーして、同じ場所に「.env」という名前で保存する。
#   2. 作成した「.env」ファイルを開き、自分の環境に合わせた値を書き換える。
#   3. 【注意】本物のIPアドレスなどを書いた「.env」は、絶対にGitにコミットしないこと！
# =========================================================================

# バックエンドAPIのベースURL
# 未設定の場合、api.js側でhttp://localhost:8080にフォールバックする
# （PC単体での動作確認のみなら、この行自体コメントアウトのままでOK）
#
# 実機（スマホ等）から開発サーバーへアクセスして動作確認したい場合は、
# 以下のようにご自身のPCのLAN内IPアドレスを入力してください。
# そうすると別端末からアクセスできるようになる窓口ができます
# 例）VITE_API_BASE_URL=http://LAN内IPアドレス:8080
VITE_API_BASE_URL=


# google reCapcha導入後にフロント側でキーを書くところ
VITE_RECAPTCHA_SITE_KEY=