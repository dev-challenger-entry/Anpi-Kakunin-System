# =========================================================================
# 【重要】このファイル（.env.example）は、環境変数の「型紙（テンプレート）」です！
# 使い方：
#   1. このファイルをコピーして、同じ場所に「.env」という名前で保存する。
#   2. 作成した「.env」ファイルを開き、大カッコ [ ] の部分を自分の本物の値に書き換える。
#   3. 【注意】本物のパスワードやAPIキーを書いた「.env」は、絶対にGitにコミットしないこと！
#   外部データ流出対策のため、何をコミットしてはいけないかをサンプルとして羅列しました。
# =========================================================================

# データベースの接続URL（例: jdbc:mysql://localhost:3306/my_db）
DB_URL=[jdbc:mysql://localhost:3306/データベース名]

# データベースのログインユーザー名（例: root）
DB_USERNAME=[データベースのユーザー名]

# データベースのログインパスワード
DB_PASSWORD=[データベースのパスワード]

# Stripeなどの決済APIのシークレットキー
STRIPE_API_KEY=[sk_test_xxxx...]

# OpenAIなどのAIモデルのAPIキー
OPENAI_API_KEY=[sk-proj-xxxx...]

# Google MapsなどのAPIキー
GOOGLE_MAPS_API_KEY=[AIzaSyxxxx...]

# AWSアクセスキー
AWS_ACCESS_KEY_ID=[AWSのアクセスキー]

# AWSシークレットキー
AWS_SECRET_ACCESS_KEY=[AWSのシークレットキー]

# 使用するS3バケット名
AWS_S3_BUCKET_NAME=[バケット名]

# JWT（暗号化トークン）の署名に使う秘密鍵（ランダムな長い文字列）
JWT_SECRET_KEY=[最低でも256ビット以上のランダムな文字列]

# JWTの有効期限（例: 86400000 = 24時間）
JWT_EXPIRATION_MS=[有効期限（ミリ秒）]

# OAuth2 (Googleログインなど) のクライアントIDとシークレット
GOOGLE_CLIENT_ID=[Googleから発行されたクライアントID]
GOOGLE_CLIENT_SECRET=[Googleから発行されたシークレット]

# メールサーバーのホスト名（例: ://gmail.com）
MAIL_HOST=[SMTPサーバーのホスト名]

# メールサーバーのポート番号（例: 587 または 465）
MAIL_PORT=[ポート番号]

# メール送信に使用するアカウント
MAIL_USERNAME=[メールアドレス]

# メール送信アカウントのパスワード（Gmailならアプリパスワード）
MAIL_PASSWORD=[メールのパスワード]

# 実行環境の指定（例: local, dev, prod）
APP_ENV=[local]

# アプリケーションが起動するポート番号（デフォルトは8080）
APP_PORT=[8080]

# ログファイルの保存先パス（ローカルとサーバーで書き込み先が変わるため）
LOG_PATH=[./logs]

